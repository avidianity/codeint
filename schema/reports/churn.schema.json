{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codeint churn JSON report",
  "description": "The JSON output of `codeint churn --format json`.",
  "type": "object",
  "required": [
    "window",
    "commits_analyzed",
    "shallow",
    "source_sets"
  ],
  "properties": {
    "window": {
      "type": "string"
    },
    "commits_analyzed": {
      "type": "integer",
      "minimum": 0
    },
    "shallow": {
      "type": "boolean"
    },
    "warning": {
      "type": "string"
    },
    "source_sets": {
      "$ref": "#/$defs/SourceSetChurnMap"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SourceSetChurnMap": {
      "type": "object",
      "properties": {
        "production": {
          "$ref": "#/$defs/SourceSetChurnSection"
        },
        "test": {
          "$ref": "#/$defs/SourceSetChurnSection"
        },
        "generated": {
          "$ref": "#/$defs/SourceSetChurnSection"
        },
        "vendored": {
          "$ref": "#/$defs/SourceSetChurnSection"
        }
      },
      "additionalProperties": false
    },
    "SourceSetChurnSection": {
      "type": "object",
      "required": [
        "files",
        "erosion",
        "duplication"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "erosion": {
          "$ref": "#/$defs/ErosionChurnSection"
        },
        "duplication": {
          "$ref": "#/$defs/DuplicationChurnSection"
        }
      },
      "additionalProperties": false
    },
    "ErosionChurnSection": {
      "type": "object",
      "required": [
        "ratio",
        "eroded_function_mass",
        "total_function_mass",
        "findings"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eroded_function_mass": {
          "type": "number",
          "minimum": 0
        },
        "total_function_mass": {
          "type": "number",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErodedChurnFile"
          }
        },
        "findings_left_out": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ErodedChurnFile": {
      "type": "object",
      "required": [
        "path",
        "commits",
        "eroded_functions",
        "eroded_function_mass",
        "max_cyclomatic_complexity"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "commits": {
          "type": "integer",
          "minimum": 0
        },
        "eroded_functions": {
          "type": "integer",
          "minimum": 0
        },
        "eroded_function_mass": {
          "type": "number",
          "minimum": 0
        },
        "max_cyclomatic_complexity": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "DuplicationChurnSection": {
      "type": "object",
      "required": [
        "ratio",
        "clone_lines",
        "findings"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "clone_lines": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DuplicatedChurnFile"
          }
        },
        "findings_left_out": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "DuplicatedChurnFile": {
      "type": "object",
      "required": [
        "path",
        "commits",
        "clone_lines",
        "clone_groups"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "commits": {
          "type": "integer",
          "minimum": 0
        },
        "clone_lines": {
          "type": "integer",
          "minimum": 0
        },
        "clone_groups": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
