{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codeint impact JSON report",
  "description": "The JSON output of `codeint impact --format json`.",
  "type": "object",
  "required": [
    "targets",
    "summary",
    "production",
    "test"
  ],
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImpactTargetRow"
      }
    },
    "changed_base": {
      "$ref": "#/$defs/ChangedBase"
    },
    "depth_limit": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "$ref": "#/$defs/ImpactSummaryRow"
    },
    "production": {
      "$ref": "#/$defs/SourceSetImpact"
    },
    "test": {
      "$ref": "#/$defs/SourceSetImpact"
    },
    "generated": {
      "$ref": "#/$defs/SourceSetImpact"
    },
    "vendored": {
      "$ref": "#/$defs/SourceSetImpact"
    },
    "affected_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ChangedBase": {
      "type": "object",
      "required": [
        "ref",
        "merge_base"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "merge_base": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ImpactTargetRow": {
      "type": "object",
      "required": [
        "path",
        "source_set",
        "fan_in",
        "fan_out",
        "transitive_import_weight"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "source_set": {
          "type": "string",
          "enum": [
            "production",
            "test",
            "generated",
            "vendored"
          ]
        },
        "package": {
          "type": "string"
        },
        "fan_in": {
          "type": "integer",
          "minimum": 0
        },
        "fan_out": {
          "type": "integer",
          "minimum": 0
        },
        "transitive_import_weight": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ImpactSummaryRow": {
      "type": "object",
      "required": [
        "direct_dependents",
        "transitive_dependents",
        "total_dependents",
        "fan_in",
        "fan_out",
        "transitive_import_weight"
      ],
      "properties": {
        "direct_dependents": {
          "type": "integer",
          "minimum": 0
        },
        "transitive_dependents": {
          "type": "integer",
          "minimum": 0
        },
        "total_dependents": {
          "type": "integer",
          "minimum": 0
        },
        "fan_in": {
          "type": "integer",
          "minimum": 0
        },
        "fan_out": {
          "type": "integer",
          "minimum": 0
        },
        "transitive_import_weight": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "SourceSetImpact": {
      "type": "object",
      "required": [
        "direct",
        "transitive"
      ],
      "properties": {
        "direct": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImpactDependentRow"
          }
        },
        "transitive": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImpactDependentRow"
          }
        }
      },
      "additionalProperties": false
    },
    "ImpactDependentRow": {
      "type": "object",
      "required": [
        "path",
        "distance"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "distance": {
          "type": "integer",
          "minimum": 1
        },
        "package": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
