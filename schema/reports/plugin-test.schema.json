{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codeint plugin test JSON report",
  "description": "The JSON output of `codeint plugin test --format json`.",
  "type": "object",
  "required": [
    "plugin",
    "kind",
    "passed",
    "summary",
    "checks"
  ],
  "properties": {
    "plugin": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "language",
        "metric"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "summary": {
      "$ref": "#/$defs/PluginTestSummary"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginTestCheck"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "PluginTestSummary": {
      "type": "object",
      "required": [
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "PluginTestCheck": {
      "type": "object",
      "required": [
        "id",
        "status",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "skipped"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
