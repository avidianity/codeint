{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codeint diff JSON report",
  "description": "The JSON output of `codeint diff --format json`.",
  "type": "object",
  "required": [
    "base",
    "head",
    "source_sets"
  ],
  "properties": {
    "base": {
      "$ref": "#/$defs/BaseEntry"
    },
    "head": {
      "$ref": "#/$defs/HeadEntry"
    },
    "test_gap_note": {
      "type": "string"
    },
    "ratchet_note": {
      "type": "string"
    },
    "manifest_warnings": {
      "$ref": "#/$defs/ManifestWarnings"
    },
    "source_sets": {
      "$ref": "#/$defs/SourceSetChangesSections"
    },
    "dependencies": {
      "$ref": "#/$defs/DependenciesChanges"
    },
    "over_budget": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BudgetFailure"
      }
    },
    "over_new_file_budget": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NewFileBudgetFailure"
      }
    },
    "over_ratchet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RatchetFailure"
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Regression"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "BaseEntry": {
      "type": "object",
      "required": [
        "ref",
        "merge_base"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "merge_base": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "HeadEntry": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "ref",
            "commit"
          ],
          "properties": {
            "ref": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ManifestWarnings": {
      "type": "object",
      "properties": {
        "base": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "head": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "SourceSetChangesSections": {
      "type": "object",
      "properties": {
        "production": {
          "$ref": "#/$defs/SourceSetChanges"
        },
        "test": {
          "$ref": "#/$defs/SourceSetChanges"
        },
        "generated": {
          "$ref": "#/$defs/SourceSetChanges"
        },
        "vendored": {
          "$ref": "#/$defs/SourceSetChanges"
        }
      },
      "additionalProperties": false
    },
    "SourceSetChanges": {
      "type": "object",
      "required": [
        "erosion",
        "cognitive_complexity",
        "duplication",
        "verbosity"
      ],
      "properties": {
        "erosion": {
          "$ref": "#/$defs/ErosionChanges"
        },
        "cognitive_complexity": {
          "$ref": "#/$defs/CognitiveComplexityChanges"
        },
        "duplication": {
          "$ref": "#/$defs/DuplicationChanges"
        },
        "verbosity": {
          "$ref": "#/$defs/VerbosityChanges"
        },
        "import_cycles": {
          "$ref": "#/$defs/ImportCyclesChanges"
        },
        "boundaries": {
          "$ref": "#/$defs/BoundariesChanges"
        },
        "orphan_files": {
          "$ref": "#/$defs/OrphanFilesChanges"
        },
        "hazards": {
          "$ref": "#/$defs/HazardsChanges"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/ExternalMetricChanges"
      }
    },
    "ErosionChanges": {
      "type": "object",
      "required": [
        "base_ratio",
        "head_ratio",
        "metric_version",
        "new",
        "resolved",
        "unchanged"
      ],
      "properties": {
        "base_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "head_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metric_version": {
          "type": "integer",
          "minimum": 1
        },
        "new": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErodedFunctionFinding"
          }
        },
        "new_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "resolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErodedFunctionFinding"
          }
        },
        "resolved_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ErodedFunctionFinding": {
      "type": "object",
      "required": [
        "id",
        "path",
        "line",
        "end_line",
        "cyclomatic_complexity",
        "cognitive_complexity",
        "source_lines",
        "function_mass"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "cyclomatic_complexity": {
          "type": "integer",
          "minimum": 0
        },
        "cognitive_complexity": {
          "type": "integer",
          "minimum": 0
        },
        "source_lines": {
          "type": "integer",
          "minimum": 0
        },
        "function_mass": {
          "type": "number",
          "minimum": 0
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "CognitiveComplexityChanges": {
