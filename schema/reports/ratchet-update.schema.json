{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codeint ratchet update JSON report",
  "description": "The JSON output of `codeint ratchet update --format json`.",
  "type": "object",
  "required": [
    "path",
    "created",
    "reset",
    "tightened",
    "loosened",
    "refreshed",
    "added",
    "unchanged",
    "removed",
    "total_entries"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "created": {
      "type": "boolean"
    },
    "reset": {
      "type": "boolean"
    },
    "replaced_invalid": {
      "type": "boolean"
    },
    "tightened": {
      "type": "integer",
      "minimum": 0
    },
    "loosened": {
      "type": "integer",
      "minimum": 0
    },
    "refreshed": {
      "type": "integer",
      "minimum": 0
    },
    "added": {
      "type": "integer",
      "minimum": 0
    },
    "unchanged": {
      "type": "integer",
      "minimum": 0
    },
    "removed": {
      "type": "integer",
      "minimum": 0
    },
    "total_entries": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
