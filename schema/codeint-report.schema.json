{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codeint check JSON report",
  "description": "The JSON output of `codeint check --format json`.",
  "type": "object",
  "required": [
    "files",
    "source_lines",
    "source_sets"
  ],
  "properties": {
    "files": {
      "type": "integer",
      "minimum": 0
    },
    "source_lines": {
      "type": "integer",
      "minimum": 0
    },
    "framework_profiles": {
      "type": "array",
      "description": "Sorted names of active Framework profiles for this measured scope.",
      "items": {
        "type": "string"
      }
    },
    "reference_range_note": {
      "type": "string",
      "description": "Note explaining Framework profile Reference range selection or fallback to base language Reference ranges."
    },
    "import_metrics_note": {
      "type": "string"
    },
    "source_sets": {
      "$ref": "#/$defs/SourceSetSections"
    },
    "test_gap_note": {
      "type": "string",
      "description": "One-line explanation shown when Test gap is absent for the Production Source set."
    },
    "coverage_unmatched_note": {
      "type": "string",
      "description": "One-line note listing every Coverage report path that matched no repository file unambiguously."
    },
    "ratchet_note": {
      "type": "string",
      "description": "One-line note shown when Ratchet enforcement is skipped, such as on --package runs."
    },
    "manifest_warnings": {
      "type": "array",
      "description": "One warning for each invalid manifest that codeint skipped; files under a skipped manifest count toward the surrounding Workspace package.",
      "items": {
        "type": "string"
      }
    },
    "baseline": {
      "type": "object",
      "description": "The Baseline in effect; present when .codeint/baseline.json exists and codeint check runs without --ignore-baseline.",
      "required": [
        "path",
        "hidden_findings"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "hidden_findings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "$ref": "#/$defs/DependenciesSection"
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/MeasuredSection"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "file_diagnostics": {
      "type": "array",
      "description": "Non-fatal per-file diagnostics emitted while lowering source files.",
      "items": {
        "$ref": "#/$defs/FileDiagnosticEntry"
      }
    },
    "scope_summaries": {
      "type": "array",
      "description": "Language-neutral summaries emitted by cross-file scope analysis per Workspace package and Dialect.",
      "items": {
        "$ref": "#/$defs/ScopeSummaryEntry"
      }
    },
    "declaration_only": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "submodules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "over_budget": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BudgetFailure"
      }
    },
    "over_ratchet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RatchetFailure"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "MeasuredSection": {
      "type": "object",
      "required": [
        "files",
        "source_lines",
        "source_sets"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "source_lines": {
          "type": "integer",
          "minimum": 0
        },
        "framework_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_range_note": {
          "type": "string"
        },
        "import_metrics_note": {
          "type": "string"
        },
        "source_sets": {
          "$ref": "#/$defs/SourceSetSections"
        },
        "test_gap_note": {
          "type": "string"
        },
        "dependencies": {
          "$ref": "#/$defs/DependenciesSection"
        }
      },
      "additionalProperties": false
    },
    "ReferenceRangeEntry": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "low",
            "high",
            "source"
          ],
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "high": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "DependenciesSection": {
      "type": "object",
      "required": [
        "unused_dependencies",
        "unlisted_dependencies",
        "dev_in_production_dependencies"
      ],
      "properties": {
        "unused_dependencies": {
          "$ref": "#/$defs/UnusedDependenciesSection"
        },
        "unlisted_dependencies": {
          "$ref": "#/$defs/UnlistedDependenciesSection"
        },
        "dev_in_production_dependencies": {
          "$ref": "#/$defs/DevInProductionDependenciesSection"
        }
      },
      "additionalProperties": false
    },
    "UnusedDependenciesSection": {
      "type": "object",
      "required": [
        "ratio",
        "metric_version",
        "unused",
        "declared",
        "findings"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metric_version": {
          "type": "integer",
          "minimum": 1
        },
        "unused": {
          "type": "integer",
          "minimum": 0
        },
        "declared": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnusedDependencyFinding"
          }
        },
        "findings_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "baselined_findings": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "UnusedDependencyFinding": {
      "type": "object",
      "required": [
        "id",
        "package",
        "manifest",
        "dependency",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "dependency": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "UnlistedDependenciesSection": {
      "type": "object",
      "required": [
        "ratio",
        "metric_version",
        "unlisted",
        "imported",
        "findings"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metric_version": {
          "type": "integer",
          "minimum": 1
        },
        "unlisted": {
          "type": "integer",
          "minimum": 0
        },
        "imported": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportedDependencyFinding"
          }
        },
        "findings_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "baselined_findings": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "DevInProductionDependenciesSection": {
      "type": "object",
      "required": [
        "ratio",
        "metric_version",
        "dev_in_production",
        "production_imported",
        "findings"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metric_version": {
          "type": "integer",
          "minimum": 1
        },
        "dev_in_production": {
          "type": "integer",
          "minimum": 0
        },
        "production_imported": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportedDependencyFinding"
          }
        },
        "findings_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "baselined_findings": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ImportedDependencyFinding": {
      "type": "object",
      "required": [
        "id",
        "package",
        "manifest",
        "dependency",
        "importers"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "dependency": {
          "type": "string"
        },
        "importers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "SourceSetSections": {
      "type": "object",
      "properties": {
        "production": {
          "$ref": "#/$defs/SourceSetSection"
        },
        "test": {
          "$ref": "#/$defs/NonProductionSourceSetSection"
        },
        "generated": {
          "$ref": "#/$defs/NonProductionSourceSetSection"
        },
        "vendored": {
          "$ref": "#/$defs/NonProductionSourceSetSection"
        }
      },
      "additionalProperties": false
    },
    "SourceSetSection": {
      "type": "object",
      "required": [
        "files",
        "source_lines",
        "erosion",
        "cognitive_complexity",
        "duplication",
        "verbosity"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "source_lines": {
          "type": "integer",
          "minimum": 0
        },
        "erosion": {
          "$ref": "#/$defs/ErosionSection"
        },
        "cognitive_complexity": {
          "$ref": "#/$defs/CognitiveComplexitySection"
        },
        "duplication": {
          "$ref": "#/$defs/DuplicationSection"
        },
        "verbosity": {
          "$ref": "#/$defs/VerbositySection"
        },
        "import_cycles": {
          "$ref": "#/$defs/ImportCyclesSection"
        },
        "boundaries": {
          "$ref": "#/$defs/BoundariesSection"
        },
        "orphan_files": {
          "$ref": "#/$defs/OrphanFilesSection"
        },
        "test_gap": {
          "$ref": "#/$defs/TestGapSection"
        },
        "hazards": {
          "$ref": "#/$defs/HazardsSection"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageSection"
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/ExternalMetricSection"
      }
    },
    "NonProductionSourceSetSection": {
      "type": "object",
      "required": [
        "files",
        "source_lines",
        "erosion",
        "cognitive_complexity",
        "duplication",
        "verbosity"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "source_lines": {
          "type": "integer",
          "minimum": 0
        },
        "erosion": {
          "$ref": "#/$defs/ErosionSection"
        },
        "cognitive_complexity": {
          "$ref": "#/$defs/CognitiveComplexitySection"
        },
        "duplication": {
          "$ref": "#/$defs/DuplicationSection"
        },
        "verbosity": {
          "$ref": "#/$defs/VerbositySection"
        },
        "import_cycles": {
          "$ref": "#/$defs/ImportCyclesSection"
        },
        "boundaries": {
          "$ref": "#/$defs/BoundariesSection"
        },
        "test_gap": false,
        "hazards": {
          "$ref": "#/$defs/HazardsSection"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageSection"
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/ExternalMetricSection"
      }
    },
    "ErosionSection": {
      "type": "object",
      "required": [
        "ratio",
        "metric_version",
        "reference_range",
        "eroded_function_mass",
        "total_function_mass",
        "findings"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metric_version": {
          "type": "integer",
          "minimum": 1
        },
        "reference_range": {
          "$ref": "#/$defs/ReferenceRangeEntry"
        },
        "eroded_function_mass": {
          "type": "number",
          "minimum": 0
        },
        "total_function_mass": {
          "type": "number",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErodedFunctionFinding"
          }
        },
        "findings_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "baselined_findings": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ErodedFunctionFinding": {
      "type": "object",
      "required": [
        "id",
        "path",
        "line",
        "end_line",
        "cyclomatic_complexity",
        "cognitive_complexity",
        "source_lines",
        "function_mass"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "cyclomatic_complexity": {
          "type": "integer",
          "minimum": 0
        },
        "cognitive_complexity": {
          "type": "integer",
          "minimum": 0
        },
        "source_lines": {
          "type": "integer",
          "minimum": 0
        },
        "function_mass": {
          "type": "number",
          "minimum": 0
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "CognitiveComplexitySection": {
      "type": "object",
      "required": [
        "ratio",
        "metric_version",
        "reference_range",
        "complex_cognitive_complexity",
        "total_cognitive_complexity",
        "findings"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metric_version": {
          "type": "integer",
          "minimum": 1
        },
        "reference_range": {
          "$ref": "#/$defs/ReferenceRangeEntry"
        },
        "complex_cognitive_complexity": {
          "type": "integer",
          "minimum": 0
        },
        "total_cognitive_complexity": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CognitiveComplexityFinding"
          }
        },
        "findings_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "baselined_findings": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "CognitiveComplexityFinding": {
      "type": "object",
      "required": [
        "id",
        "path",
        "line",
        "end_line",
        "cognitive_complexity",
        "cyclomatic_complexity",
        "source_lines"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "cognitive_complexity": {
          "type": "integer",
          "minimum": 0
        },
        "cyclomatic_complexity": {
          "type": "integer",
          "minimum": 0
        },
        "source_lines": {
          "type": "integer",
          "minimum": 0
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DuplicationSection": {
      "type": "object",
      "required": [
        "ratio",
        "metric_version",
        "reference_range",
        "clone_lines",
        "clone_groups"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metric_version": {
          "type": "integer",
          "minimum": 1
        },
        "reference_range": {
          "$ref": "#/$defs/ReferenceRangeEntry"
        },
        "near_clones": {
          "$ref": "#/$defs/NearClonesSummary"
        },
        "clone_lines": {
          "type": "integer",
          "minimum": 0
        },
        "clone_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CloneGroupFinding"
          }
        },
        "findings_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "baselined_findings": {
          "type": "integer",
          "minimum": 1
        },
        "clone_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CloneFamilyFinding"
          }
        },
        "clone_families_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "unlisted_clone_family_group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "NearClonesSummary": {
      "type": "object",
      "required": [
        "min_similarity"
      ],
      "properties": {
        "min_similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "CloneLocation": {
      "type": "object",
      "required": [
        "path",
        "start_line",
        "end_line"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "CloneGroupFinding": {
      "type": "object",
      "required": [
        "id",
        "tokens",
        "locations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CloneLocation"
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "CloneFamilyFinding": {
      "type": "object",
      "required": [
        "id",
        "duplicated_lines",
        "clone_group_ids",
        "locations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "duplicated_lines": {
          "type": "integer",
          "minimum": 0
        },
        "clone_group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CloneLocation"
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "VerbositySection": {
      "type": "object",
      "required": [
        "ratio",
        "metric_version",
        "reference_range",
        "verbose_lines",
        "flagged_lines",
        "findings"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metric_version": {
          "type": "integer",
          "minimum": 1
        },
        "reference_range": {
          "$ref": "#/$defs/ReferenceRangeEntry"
        },
        "verbose_lines": {
          "type": "integer",
          "minimum": 0
        },
        "flagged_lines": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlaggedLineFinding"
          }
        },
        "findings_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "baselined_findings": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "FlaggedLineFinding": {
      "type": "object",
      "required": [
        "id",
        "path",
        "line",
        "rule"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "rule": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ImportCyclesSection": {
      "type": "object",
      "required": [
        "ratio",
        "metric_version",
        "reference_range",
        "modules_in_import_cycles",
        "modules",
        "findings",
        "unresolved_imports"
      ],
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metric_version": {
          "type": "integer",
          "minimum": 1
        },
        "reference_range": {
          "$ref": "#/$defs/ReferenceRangeEntry"
        },
        "modules_in_import_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "modules": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportCycleFinding"
          }
        },
        "findings_left_out": {
          "type": "integer",
          "minimum": 1
        },
        "baselined_findings": {
          "type": "integer",
          "minimum": 1
        },
        "unresolved_imports": {
          "$ref": "#/$defs/UnresolvedImportsSection"
        }
      },
      "additionalProperties": false
