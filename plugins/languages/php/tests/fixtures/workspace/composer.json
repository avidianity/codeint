{
  "name": "acme/root",
  "repositories": [
    { "type": "path", "url": "packages/*" }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "lib-openssl": "*",
    "composer-runtime-api": "^2.2",
    "monolog/monolog": "^3.6",
    "Illuminate/Support": "^11.0",
    "acme/http-client": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "ext-xdebug": "*"
  },
  "suggest": {
    "symfony/cache": "Optional PSR-6 cache",
    "ext-redis": "Optional Redis extension"
  }
}
