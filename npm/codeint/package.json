{
  "name": "codeint",
  "version": "0.7.1",
  "description": "Measures the Software entropy of a codebase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/avidianity/codeint.git",
    "directory": "npm/codeint"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "bin": {
    "codeint": "bin/codeint.js"
  },
  "files": [
    "bin/codeint.js",
    "lib/"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@avidian/codeint-darwin-arm64": "0.7.1",
    "@avidian/codeint-darwin-x64": "0.7.1",
    "@avidian/codeint-linux-arm64": "0.7.1",
    "@avidian/codeint-linux-x64": "0.7.1",
    "@avidian/codeint-win32-arm64": "0.7.1",
    "@avidian/codeint-win32-x64": "0.7.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
